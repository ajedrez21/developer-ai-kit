{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-ai.local/schemas/v1/work-context.json",
  "title": "team-ai/v1 work-context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "artifactId",
    "generatedAt",
    "workItem",
    "parentWorkItem",
    "contextVersion",
    "contextHash",
    "repositories",
    "summary",
    "scope",
    "acceptanceCriteria",
    "contracts",
    "dependencies",
    "evidence",
    "gaps",
    "testPlan",
    "assignedTo",
    "readiness"
  ],
  "properties": {
    "schemaVersion": { "const": "team-ai/v1" },
    "artifactType": { "const": "work-context" },
    "artifactId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string" },
    "workItem": { "$ref": "#/$defs/workItem" },
    "parentWorkItem": { "anyOf": [{ "$ref": "#/$defs/workItem" }, { "type": "null" }] },
    "contextVersion": { "type": "integer", "minimum": 1 },
    "contextHash": { "type": "string", "minLength": 64 },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repoId", "role", "baseRef", "baseSha"],
        "properties": {
          "repoId": { "type": "string" },
          "role": { "enum": ["frontend", "backend", "shared"] },
          "baseRef": { "type": "string" },
          "baseSha": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["functionalGoal", "currentBehavior", "expectedBehavior"],
      "properties": {
        "functionalGoal": { "type": "string" },
        "currentBehavior": { "type": "string" },
        "expectedBehavior": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded", "candidateFiles"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "candidateFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "evidenceIds"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "version", "status", "sourceEvidenceIds", "definition"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "version": { "type": "string" },
          "status": { "enum": ["UNKNOWN", "PROPOSED", "CONFIRMED", "NOT_APPLICABLE"] },
          "sourceEvidenceIds": { "type": "array", "items": { "type": "string" } },
          "definition": {}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "blocks", "evidenceIds"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "status": { "enum": ["UNKNOWN", "PENDING", "SATISFIED", "NOT_APPLICABLE"] },
          "blocks": { "type": "array", "items": { "type": "string" } },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "classification", "observedAt", "summary"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "source": { "type": "string" },
          "classification": { "enum": ["CONFIRMED", "INFERRED", "UNKNOWN"] },
          "observedAt": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "blocking", "evidenceIds"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "blocking": { "type": "boolean" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "testPlan": { "type": "array" },
    "assignedTo": { "type": ["string", "null"] },
    "readiness": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["DRAFT", "BLOCKED", "READY"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "workItem": {
      "type": "object",
      "required": ["organization", "project", "id", "revision", "url"],
      "properties": {
        "organization": { "type": "string" },
        "project": { "type": "string" },
        "id": { "type": "integer" },
        "revision": { "type": "integer" },
        "url": { "type": "string" }
      }
    }
  }
}
