{
  "name": "@team-ai/engineering-kit",
  "version": "1.0.0",
  "description": "Kit portable para Claude Code y Cursor: OpenSpec, Azure DevOps, verificación, seguridad y trazabilidad.",
  "type": "module",
  "bin": {
    "team-ai": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "rules",
    "mcp",
    "contracts",
    "templates",
    "adapters",
    "docs",
    "ci",
    "VERSION"
